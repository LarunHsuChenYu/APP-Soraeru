<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Soraeru.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Soraeru.Pages"
    Title="空耳聯合國"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <!-- Auth / cold start (no tab bar) -->
    <ShellContent
        Title="Splash"
        ContentTemplate="{DataTemplate pages:SplashPage}"
        Route="SplashPage" />

    <!-- Main tabs: 首頁／單字本／設定（L11 HTML bottom nav） -->
    <TabBar Route="main"
            Shell.TabBarBackgroundColor="{StaticResource SurfaceContainer}">
        <ShellContent x:Name="HomeTab"
                      Title="首頁"
                      Route="HomePage"
                      Icon="ic_home.png" />
        <ShellContent x:Name="NotebookTab"
                      Title="單字本"
                      Route="NotebookListPage"
                      Icon="ic_import_contacts.png" />
        <ShellContent x:Name="SettingsTab"
                      Title="設定"
                      Route="SettingsPage"
                      Icon="ic_settings.png" />
    </TabBar>

</Shell>
