<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soraeru.Pages.OnboardingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceBright}">

    <Grid RowDefinitions="*,Auto" Padding="0">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,48,16,24"
                                 Spacing="12"
                                 MaximumWidthRequest="480"
                                 HorizontalOptions="Center">

                <!-- Hero: brand mark + title + subtitle (Stitch L04) -->
                <VerticalStackLayout Spacing="8"
                                     Margin="0,0,0,12"
                                     HorizontalOptions="Center">
                    <Image Source="logo.png"
                           HeightRequest="80"
                           WidthRequest="80"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           Margin="0,0,0,8">
                        <Image.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.12" />
                        </Image.Shadow>
                    </Image>

                    <Label Text="歡迎使用空耳聯合國"
                           Style="{StaticResource PageTitle}"
                           FontSize="26"
                           HorizontalTextAlignment="Center" />

                    <!-- Forced break after comma (avoid orphan 「字。」) -->
                    <Label Text="透過 AI 將外語轉換為您熟悉的發音，&#10;輕鬆記憶每個新單字。"
                           Style="{StaticResource BodyLabel}"
                           FontSize="15"
                           LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center"
                           Margin="12,0" />
                </VerticalStackLayout>

                <!-- Step 1 -->
                <Border Style="{StaticResource CardBorder}"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SecondaryContainer}"
                                HeightRequest="32"
                                WidthRequest="32"
                                VerticalOptions="Start"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="1"
                                   TextColor="{StaticResource OnSecondaryContainer}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="輸入或拍照取得外語單字"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="17" />
                            <Label Text="直接輸入您想學的單字，或是拍下書本上的內容。"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Step 2 -->
                <Border Style="{StaticResource CardBorder}"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SecondaryContainer}"
                                HeightRequest="32"
                                WidthRequest="32"
                                VerticalOptions="Start"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="2"
                                   TextColor="{StaticResource OnSecondaryContainer}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="AI 自動判斷語言並產空耳"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="17" />
                            <Label Text="系統會自動辨識語言種類，並生成多種有趣的諧音組合。"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Step 3 -->
                <Border Style="{StaticResource CardBorder}"
                        BackgroundColor="{StaticResource Surface}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SecondaryContainer}"
                                HeightRequest="32"
                                WidthRequest="32"
                                VerticalOptions="Start"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="3"
                                   TextColor="{StaticResource OnSecondaryContainer}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="選一個好記的近似音收藏"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="17" />
                            <Label Text="挑選最適合您的空耳記憶法，存入專屬單字卡隨時查看。"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Warning panel (peach, left accent, info / shield icons) -->
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource WarningContainer}"
                        StrokeShape="RoundRectangle 12"
                        Padding="0"
                        Margin="0,8,0,0">
                    <Grid ColumnDefinitions="4,*">
                        <BoxView Grid.Column="0"
                                 Color="{StaticResource StatusWarning}" />
                        <VerticalStackLayout Grid.Column="1" Padding="12,14" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image Grid.Column="0"
                                       Source="ic_info.png"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       Aspect="AspectFit"
                                       VerticalOptions="Start"
                                       Margin="0,1,0,0" />
                                <Label Grid.Column="1"
                                       Text="近似音僅供記憶，請以正式發音為準。"
                                       TextColor="{StaticResource StatusWarning}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{StaticResource StatusWarning}"
                                     Opacity="0.2" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Image Grid.Column="0"
                                       Source="ic_shield.png"
                                       HeightRequest="20"
                                       WidthRequest="20"
                                       Aspect="AspectFit"
                                       VerticalOptions="Start"
                                       Margin="0,1,0,0" />
                                <Label Grid.Column="1"
                                       Text="圖片只在手機辨識，不會上傳原圖。"
                                       TextColor="{StaticResource StatusWarning}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" Style="{StaticResource StickyBar}" BackgroundColor="{StaticResource SurfaceBright}">
            <Button x:Name="StartButton"
                    Text="開始使用  →"
                    Style="{StaticResource PrimaryButton}"
                    CornerRadius="28"
                    Clicked="OnStartClicked" />
        </Grid>
    </Grid>
</ContentPage>
