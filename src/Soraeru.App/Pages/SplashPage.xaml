<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Soraeru.Controls"
             x:Class="Soraeru.Pages.SplashPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceBright}">

    <Grid>
        <!-- Stitch L00: fly-across multilingual mnemonic pairs -->
        <controls:FloatingMnemonicBackground x:Name="AmbientBackground"
                                             TargetOpacity="0.8"
                                             SpawnIntervalMs="300" />

        <!-- Brand stack (Stitch L00 center) -->
        <VerticalStackLayout x:Name="BrandStack"
                             Opacity="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8"
                             Padding="32"
                             MaximumWidthRequest="360">

            <Image x:Name="BrandMark"
                   Source="logo.png"
                   HeightRequest="96"
                   WidthRequest="96"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Image.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.18" />
                </Image.Shadow>
            </Image>

            <Label x:Name="TitleLabel"
                   Text="空耳聯合國"
                   TextColor="{StaticResource OnSurface}"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="NoWrap" />

            <Label x:Name="TaglineLabel"
                   Text="用發音，記住外語"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   FontSize="20"
                   HorizontalTextAlignment="Center"
                   Margin="0,4,0,0" />
        </VerticalStackLayout>

        <!-- Three bounce dots (Stitch L00 loading-dot) -->
        <HorizontalStackLayout x:Name="LoaderDots"
                               Opacity="0"
                               Spacing="8"
                               VerticalOptions="End"
                               HorizontalOptions="Center"
                               Margin="0,0,0,72">
            <Ellipse x:Name="Dot1"
                     Fill="{StaticResource Primary}"
                     WidthRequest="10"
                     HeightRequest="10"
                     Scale="0" />
            <Ellipse x:Name="Dot2"
                     Fill="{StaticResource Primary}"
                     WidthRequest="10"
                     HeightRequest="10"
                     Scale="0" />
            <Ellipse x:Name="Dot3"
                     Fill="{StaticResource Primary}"
                     WidthRequest="10"
                     HeightRequest="10"
                     Scale="0" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
