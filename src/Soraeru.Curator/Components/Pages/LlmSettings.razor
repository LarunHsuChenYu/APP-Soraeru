@page "/llm-settings"
@using Soraeru.Curator.Api
@inject ICuratorApiClient Api
@inject CuratorSessionState SessionState
@inject NavigationManager Nav

<PageTitle>LLM 設定 — Soraeru 策展</PageTitle>

@if (!EnsureAccess())
{
    return;
}

<h1>LLM 設定</h1>
<p class="text-muted">
    ApiKey／Model／BaseUrl／System Prompt <strong>存在 API 的 SQLite</strong>。
    金鑰與端點請求時只讀 DB；Prompt 有 DB 覆寫時用 DB，否則用程式內嵌預設。儲存後立刻生效。
</p>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrWhiteSpace(_ok))
{
    <div class="alert alert-success">@_ok</div>
}

@if (_settings is null)
{
    <p>載入中…</p>
}
else
{
    <dl class="row" style="max-width: 48rem;">
        <dt class="col-sm-4">目前金鑰（DB）</dt>
        <dd class="col-sm-8">
            <code>@_settings.ApiKeyMasked</code>
            @if (_settings.ApiKeyFromDatabase)
            {
                <span class="badge text-bg-info ms-1">SQLite</span>
            }
            else
            {
                <span class="badge text-bg-warning ms-1">未設定</span>
            }
        </dd>
        <dt class="col-sm-4">目前 Model（DB）</dt>
        <dd class="col-sm-8">
            <code>@(string.IsNullOrWhiteSpace(_settings.Model) ? "（未設定）" : _settings.Model)</code>
        </dd>
        <dt class="col-sm-4">目前 BaseUrl（DB）</dt>
        <dd class="col-sm-8">
            <code>@(string.IsNullOrWhiteSpace(_settings.BaseUrl) ? "（未設定）" : _settings.BaseUrl)</code>
        </dd>
        <dt class="col-sm-4">System Prompt 來源</dt>
        <dd class="col-sm-8">
            @if (_settings.SystemPromptFromDatabase)
            {
                <span class="badge text-bg-info">SQLite</span>
            }
            else
            {
                <span class="badge text-bg-secondary">內嵌預設</span>
            }
        </dd>
        <dt class="col-sm-4">詞義／讀音 Prompt 來源</dt>
        <dd class="col-sm-8">
            @if (_settings.MeaningReadingOnlySystemPromptFromDatabase)
            {
                <span class="badge text-bg-info">SQLite</span>
            }
            else
            {
                <span class="badge text-bg-secondary">內嵌預設</span>
            }
        </dd>
    </dl>

    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="row g-3" style="max-width: 48rem;">
        <div class="col-12">
            <label class="form-label">新 ApiKey（留空＝不變更）</label>
            <InputText type="password" class="form-control" @bind-Value="_form.ApiKey" autocomplete="off" />
        </div>
        <div class="col-12">
            <label class="form-label">Model</label>
            <InputText class="form-control" @bind-Value="_form.Model" />
            <div class="form-text">必填；儲存空字串會清除 DB Model（分析將失敗直到再填）</div>
        </div>
        <div class="col-12">
            <label class="form-label">BaseUrl</label>
            <InputText class="form-control" @bind-Value="_form.BaseUrl" />
            <div class="form-text">OpenAI-compatible 端點，無尾隨斜線</div>
        </div>
        <div class="col-12">
            <label class="form-label">System Prompt（完整空耳分析）</label>
            <InputTextArea class="form-control font-monospace" rows="14" @bind-Value="_form.SystemPrompt" />
            <div class="form-text">儲存後立刻生效。清空並儲存＝改回程式內嵌預設（word-analysis）。</div>
        </div>
        <div class="col-12">
            <label class="form-label">詞義／讀音 System Prompt（已核定覆寫路徑）</label>
            <InputTextArea class="form-control font-monospace" rows="10" @bind-Value="_form.MeaningReadingOnlySystemPrompt" />
            <div class="form-text">SkipMnemonics／金標命中時使用。清空並儲存＝改回內嵌預設。</div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary" disabled="@_busy">儲存</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ResetPromptsToEmbeddedAsync" disabled="@_busy">
                重填內嵌預設（未儲存）
            </button>
            <button type="button" class="btn btn-link" @onclick="LoadAsync" disabled="@_busy">重新載入</button>
        </div>
    </EditForm>
}

@code {
    private LlmSettingsDto? _settings;
    private readonly FormModel _form = new();
    private string? _error;
    private string? _ok;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await SessionState.EnsureHydratedAsync();
        if (!EnsureAccess())
        {
            return;
        }

        await LoadAsync();
    }

    private bool EnsureAccess()
    {
        if (SessionState.CanEnterMaintenance)
        {
            return true;
        }

        Nav.NavigateTo(SessionState.Session is null ? "/login" : "/access-denied");
        return false;
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.GetLlmSettingsAsync(SessionState.Session!.AccessToken);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.ErrorMessage ?? "載入失敗。";
                return;
            }

            _settings = result.Value;
            _form.Model = _settings.Model;
            _form.BaseUrl = _settings.BaseUrl;
            _form.ApiKey = "";
            _form.SystemPrompt = _settings.SystemPrompt;
            _form.MeaningReadingOnlySystemPrompt = _settings.MeaningReadingOnlySystemPrompt;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ResetPromptsToEmbeddedAsync()
    {
        if (_settings is null)
        {
            return Task.CompletedTask;
        }

        _form.SystemPrompt = _settings.ConfigSystemPrompt;
        _form.MeaningReadingOnlySystemPrompt = _settings.ConfigMeaningReadingOnlySystemPrompt;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        _ok = null;
        try
        {
            var body = new UpdateLlmSettingsBody(
                string.IsNullOrWhiteSpace(_form.ApiKey) ? null : _form.ApiKey,
                ClearApiKey: false,
                _form.Model,
                _form.BaseUrl,
                _form.SystemPrompt,
                _form.MeaningReadingOnlySystemPrompt);
            var result = await Api.UpdateLlmSettingsAsync(SessionState.Session!.AccessToken, body);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.ErrorMessage ?? "儲存失敗。";
                return;
            }

            _settings = result.Value;
            _ok = "已儲存至 SQLite，分析請求會立刻使用新設定。";
            _form.ApiKey = "";
            _form.Model = _settings.Model;
            _form.BaseUrl = _settings.BaseUrl;
            _form.SystemPrompt = _settings.SystemPrompt;
            _form.MeaningReadingOnlySystemPrompt = _settings.MeaningReadingOnlySystemPrompt;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class FormModel
    {
        public string ApiKey { get; set; } = "";
        public string Model { get; set; } = "";
        public string BaseUrl { get; set; } = "";
        public string SystemPrompt { get; set; } = "";
        public string MeaningReadingOnlySystemPrompt { get; set; } = "";
    }
}
