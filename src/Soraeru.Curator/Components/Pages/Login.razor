@page "/login"
@using Soraeru.Curator.Api
@inject ICuratorApiClient Api
@inject CuratorSessionState SessionState
@inject NavigationManager Nav

<PageTitle>策展登入 — Soraeru</PageTitle>

<h1>策展登入</h1>
<p class="text-muted">僅允許清單內帳號可進入維護面。登入後呼叫共用本機 API（不另起後端）。</p>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<section>
    <EditForm Model="_emailForm" OnValidSubmit="LoginEmailAsync" class="row g-2" style="max-width: 28rem;">
        <div class="col-12">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="_emailForm.Email" />
        </div>
        <div class="col-12">
            <label class="form-label">密碼</label>
            <InputText type="password" class="form-control" @bind-Value="_emailForm.Password" />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary" disabled="@_busy">登入</button>
        </div>
    </EditForm>
</section>

@code {
    private readonly EmailForm _emailForm = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await SessionState.EnsureHydratedAsync();
        if (SessionState.CanEnterMaintenance)
        {
            Nav.NavigateTo("/verified");
        }
    }

    private async Task LoginEmailAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.LoginWithEmailAsync(_emailForm.Email, _emailForm.Password);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.ErrorMessage ?? "登入失敗。";
                return;
            }

            await SessionState.SetAsync(result.Value);
            if (!SessionState.CanEnterMaintenance)
            {
                Nav.NavigateTo("/access-denied");
                return;
            }

            Nav.NavigateTo("/verified");
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class EmailForm
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
